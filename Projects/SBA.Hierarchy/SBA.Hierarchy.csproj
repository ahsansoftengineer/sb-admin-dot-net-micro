<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <!-- <NoWarn>CS0162;CS8604;CS1998;NETSDK1206</NoWarn> -->
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' and '$(UseNuget)' == ''">
    <UseNuget>false</UseNuget>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseNuget)' == 'true'">
    <PackageReference Include="GLOB.API" Version="1.0.*" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseNuget)' == 'false'">
    <ProjectReference Include="..\..\GLOB\GLOB.API\GLOB.API.csproj" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\..\GLOB\GLOB.Domain\GLOB.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Grpc.Tools" Version="2.72.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\certs\dev-cert.pfx" Link="certs\dev-cert.pfx" CopyToOutputDirectory="Always" />
    <Protobuf Include="_Clients\Protos\base.proto" GrpcServices="Client" />
    <Protobuf Include="_Clients\Protos\projectzlookup.proto" GrpcServices="Client" AdditionalImportDirs="_Clients\Protos" />
  </ItemGroup>

  <ItemGroup>
    <!-- <Protobuf Include="_Clients\Protos\projectzlookup.jackson.proto" GrpcServices="Server" /> -->
    <!-- <Protobuf Include="_Clients\Protos\**\*.proto" GrpcServices="Server" /> -->
  </ItemGroup>

</Project>
